{
    "name": "bhamner/schema-fox",
    "description": "Build HTML forms from MySQL table schema for Laravel models",
    "type": "library",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Brian Hamner",
            "email": "brianhamner@protonmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/session": "^10.0|^11.0",
        "illuminate/support": "^10.0|^11.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Bhamner\\SchemaFox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bhamner\\SchemaFox\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
